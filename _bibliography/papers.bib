@article{malikmoraleda2025constructed,
  title={Constructed languages are processed by the same brain mechanisms as natural languages},
  author={Malik-Moraleda, Saima and Taliaferro, Maya and Shannon, Steve and Jhingan, Niharika and Swords, Sara and Peterson, David J and Frommer, Paul and Okrand, Marc and Peterson, Jessie and Cardwell, Ramsey and Freeman, Cassie and Fedorenko, Evelina},
  journal={Proceedings of the National Academy of Sciences},
  volume={122},
  number={12},
  pages={e2313473122},
  year={2025},
  selected={true},
  preview={pnas2025.jpg},
  bibtex_show={true},
  doi={10.1073/pnas.2313473122},
  annotation={Constructed languages are processed by the same brain mechanisms as natural languages.},
  abstract={What constitutes a language? Natural languages share features with other domains: from math, to music, to gesture. However, the brain mechanisms that process linguistic input are highly specialized, showing little response to diverse nonlinguistic tasks. Here, we examine constructed languages (conlangs) to ask whether they draw on the same neural mechanisms as natural languages or whether they instead pattern with domains like math and programming languages. Using individual-subject fMRI analyses, we show that understanding conlangs recruits the same brain areas as natural language comprehension. This result holds for Esperanto (n = 19 speakers) and four fictional conlangs (Klingon, Na'vi, High Valyrian, and Dothraki). These findings suggest that conlangs and natural languages share critical features that allow them to draw on the same representations and computations, implemented in the left-lateralized network of brain areas. We argue that the critical shared feature of conlangs and natural languages is that they are symbolic systems capable of expressing an open-ended range of meanings about our outer and inner worlds.}
}

